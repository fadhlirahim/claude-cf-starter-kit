# Local secrets — copy to `.dev.vars` (Cloudflare's local secrets file).
# `.dev.vars` is blocked from automated edits by .claude/hooks/protect-sensitive.sh.
# Generate BETTER_AUTH_SECRET with: openssl rand -base64 32

# better-auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5173

# Cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# AI Gateway (slug only — set in wrangler.jsonc vars too if non-secret)
AI_GATEWAY_ID=

# Optional AI provider keys (used when calling AI SDK through the gateway)
# OPENAI_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=

# Optional R2 signed-URL secret (set via `wrangler secret put` for prod)
# ASSET_SIGNING_SECRET=

# Optional OAuth provider secrets (set per provider via /add-auth-provider)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
